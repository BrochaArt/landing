# --- Supabase: guarda la lista de acceso anticipado -------------------------
# Sin prefijo NEXT_PUBLIC_ a propósito: solo se leen en el servidor
# (app/api/subscribe/route.ts) y nunca llegan al navegador.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Resend: correo de bienvenida al suscriptor ----------------------------
# Si falta la key, la suscripción se guarda igual y solo se omite el correo.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Mientras brocha.art no esté verificado en Resend hay que dejar el remitente
# de pruebas, que SOLO entrega al correo dueño de la cuenta de Resend.
RESEND_FROM=BROCHA <onboarding@resend.dev>
# Opcional: si se define, cada alta se suma además a ese segmento de Resend.
# Sin él los contactos igual se crean (en Resend son globales) y se pueden
# segmentar después desde el panel.
RESEND_SEGMENT_ID=

# --- Módulo de envíos (/admin) --------------------------------------------
# Sin esta variable el módulo queda deshabilitado por completo: los endpoints
# responden 503 y la página no deja entrar. Mínimo 12 caracteres.
# Es un secreto compartido, no cuentas por persona: no registra quién envió qué.
ADMIN_PASSWORD=

